<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Control Panel | Portfolio Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  
  <style>
    /* Sticky Dynamic Top Navigation */
    .admin-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(11, 17, 32, 0.95);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
    }

    .admin-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.8rem 5%;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .admin-brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.15rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.3px;
    }

    .admin-brand span {
      color: var(--accent);
    }

    /* Scrollable Dynamic Sub-Navigation Bar */
    .admin-dynamic-nav {
      display: flex;
      gap: 0.5rem;
      padding: 0.6rem 5%;
      overflow-x: auto;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE/Edge */
    }

    .admin-dynamic-nav::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }

    .nav-tab-item {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid transparent;
      white-space: nowrap;
      transition: all 0.2s ease;
    }

    .nav-tab-item:hover {
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.07);
      border-color: var(--border);
    }

    .nav-tab-item.active {
      color: #ffffff;
      background: rgba(99, 102, 241, 0.18);
      border-color: rgba(99, 102, 241, 0.4);
    }

    .tab-badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 1px 6px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.1);
      color: var(--accent);
    }

    .nav-tab-item.active .tab-badge {
      background: var(--primary);
      color: #ffffff;
    }

    /* Container & Layout */
    .admin-container {
      max-width: 1200px;
      margin: 2.5rem auto;
      padding: 0 1.5rem;
    }

    .admin-section {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2.5rem;
      scroll-margin-top: 130px; /* Offset for sticky nav */
    }

    .admin-section h2 {
      font-size: 1.35rem;
      color: var(--accent);
      margin-bottom: 1.2rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .admin-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1.5rem;
      font-size: 0.9rem;
    }

    .admin-table th, .admin-table td {
      padding: 0.8rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    .admin-table th {
      background: rgba(255, 255, 255, 0.03);
      color: var(--text-muted);
      font-weight: 600;
    }

    .btn-delete {
      background: #ef4444;
      color: #ffffff;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      border: none;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-delete:hover {
      background: #dc2626;
    }
  </style>
</head>
<body>

  <!-- Dynamic Header & Navigation -->
  <header class="admin-header">
    <div class="admin-top-bar">
      <div class="admin-brand">
        ⚡ <span>Control Panel</span>
      </div>
      <div style="display: flex; gap: 0.8rem; align-items: center;">
        <a href="/" target="_blank" class="btn secondary" style="padding: 0.35rem 0.85rem; font-size: 0.85rem;">Live Site ↗</a>
        <a href="/admin/logout" class="btn primary" style="padding: 0.35rem 0.85rem; font-size: 0.85rem; background: #ef4444;">Logout</a>
      </div>
    </div>

    <!-- Dynamic Table Tabs -->
    <nav class="admin-dynamic-nav" id="admin-tabs">
      <% navSections.forEach(section => { %>
        <a href="#<%= section.id %>" class="nav-tab-item">
          <span><%= section.icon %></span>
          <span><%= section.label %></span>
          <span class="tab-badge"><%= section.count %></span>
        </a>
      <% }); %>
    </nav>
  </header>

  <!-- Admin Main Dashboard Cards -->
  <main class="admin-container">

    <!-- 1. Profile Details -->
    <section id="profile" class="admin-section">
      <h2><span>👤 Profile Information</span></h2>
      <form action="/admin/profile/update" method="POST">
        <div class="form-row">
          <input type="text" name="name" value="<%= profile.name || '' %>" placeholder="Full Name" required />
          <input type="text" name="headline" value="<%= profile.headline || '' %>" placeholder="Headline" required />
        </div>
        <div class="form-row">
          <input type="text" name="github_username" value="<%= profile.github_username || '' %>" placeholder="GitHub Username" required />
          <input type="url" name="linkedin_url" value="<%= profile.linkedin_url || '' %>" placeholder="LinkedIn URL" />
        </div>
        <div class="form-row">
          <input type="text" name="location" value="<%= profile.location || '' %>" placeholder="Location" />
          <input type="email" name="email" value="<%= profile.email || '' %>" placeholder="Contact Email" />
        </div>
        <textarea name="bio" rows="3" placeholder="Bio Narrative" required><%= profile.bio || '' %></textarea>
        <button type="submit" class="btn primary" style="align-self: flex-start; margin-top: 0.5rem;">Save Profile Changes</button>
      </form>
    </section>

    <!-- 2. Skills -->
    <section id="skills" class="admin-section">
      <h2><span>⚡ Skills & Technologies</span> <span class="tab-badge"><%= skills.length %> Records</span></h2>
      <form action="/admin/skills/create" method="POST" style="margin-bottom: 1.5rem;">
        <div class="form-row">
          <input type="text" name="name" placeholder="Skill Name (e.g. Kotlin, Docker)" required />
          <input type="text" name="category" placeholder="Category (e.g. Mobile, AI, Cloud)" required />
        </div>
        <button type="submit" class="btn primary" style="align-self: flex-start;">+ Add Skill</button>
      </form>

      <table class="admin-table">
        <thead><tr><th>Skill Name</th><th>Category</th><th>Action</th></tr></thead>
        <tbody>
          <% skills.forEach(s => { %>
            <tr>
              <td><strong><%= s.name %></strong></td>
              <td><%= s.category %></td>
              <td>
                <form action="/admin/skills/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Delete this skill?');">
                  <button type="submit" class="btn-delete">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- 3. Experiences -->
    <section id="experience" class="admin-section">
      <h2><span>💼 Work Experience Journey</span> <span class="tab-badge"><%= experiences.length %> Records</span></h2>
      <form action="/admin/experiences/create" method="POST" style="margin-bottom: 1.5rem;">
        <div class="form-row">
          <input type="text" name="role" placeholder="Role / Title" required />
          <input type="text" name="company" placeholder="Company Name" required />
        </div>
        <div class="form-row">
          <input type="text" name="period" placeholder="Period (e.g. 2024 - Present)" required />
          <input type="text" name="location" placeholder="Location" required />
        </div>
        <input type="text" name="skills_used" placeholder="Stack Used (comma separated)" />
        <textarea name="description" rows="3" placeholder="Key responsibilities and achievements..." required></textarea>
        <button type="submit" class="btn primary" style="align-self: flex-start;">+ Add Work Experience</button>
      </form>

      <table class="admin-table">
        <thead><tr><th>Role & Company</th><th>Period</th><th>Actions</th></tr></thead>
        <tbody>
          <% experiences.forEach(exp => { %>
            <tr>
              <td><strong><%= exp.role %></strong><br><span style="color:var(--text-muted);"><%= exp.company %></span></td>
              <td><%= exp.period %></td>
              <td>
                <form action="/admin/experiences/delete/<%= exp.id %>" method="POST" onsubmit="return confirm('Delete this experience?');">
                  <button type="submit" class="btn-delete">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- 4. Projects -->
    <section id="projects" class="admin-section">
      <h2><span>🚀 Featured Projects & AI Apps</span> <span class="tab-badge"><%= projects.length %> Records</span></h2>
      <form action="/admin/projects/create" method="POST" style="margin-bottom: 1.5rem;">
        <div class="form-row">
          <input type="text" name="title" placeholder="Project Title" required />
          <input type="text" name="category" placeholder="Category (e.g. Mobile App, AI System)" required />
        </div>
        <div class="form-row">
          <input type="text" name="technologies" placeholder="Tech Stack (e.g. Kotlin, Compose, AWS)" required />
          <input type="url" name="github_url" placeholder="GitHub URL" />
          <input type="url" name="live_url" placeholder="Live URL" />
        </div>
        <textarea name="description" rows="2" placeholder="Project description..." required></textarea>
        <button type="submit" class="btn primary" style="align-self: flex-start;">+ Add Project</button>
      </form>

      <table class="admin-table">
        <thead><tr><th>Title</th><th>Category</th><th>Tech</th><th>Action</th></tr></thead>
        <tbody>
          <% projects.forEach(p => { %>
            <tr>
              <td><strong><%= p.title %></strong></td>
              <td><%= p.category %></td>
              <td><%= p.technologies %></td>
              <td>
                <form action="/admin/projects/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete this project?');">
                  <button type="submit" class="btn-delete">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- 5. Education -->
    <section id="education" class="admin-section">
      <h2><span>🎓 Education & Academics</span> <span class="tab-badge"><%= education.length %> Records</span></h2>
      <form action="/admin/education/create" method="POST" style="margin-bottom: 1.5rem;">
        <div class="form-row">
          <input type="text" name="degree" placeholder="Degree / Course" required />
          <input type="text" name="institution" placeholder="Institution" required />
        </div>
        <div class="form-row">
          <input type="text" name="period" placeholder="Period (e.g. 2024 - 2026)" required />
          <input type="text" name="description" placeholder="Brief note / coursework" />
        </div>
        <button type="submit" class="btn primary" style="align-self: flex-start;">+ Add Education</button>
      </form>

      <table class="admin-table">
        <thead><tr><th>Degree</th><th>Institution</th><th>Period</th><th>Action</th></tr></thead>
        <tbody>
          <% education.forEach(e => { %>
            <tr>
              <td><strong><%= e.degree %></strong></td>
              <td><%= e.institution %></td>
              <td><%= e.period %></td>
              <td>
                <form action="/admin/education/delete/<%= e.id %>" method="POST" onsubmit="return confirm('Delete this degree?');">
                  <button type="submit" class="btn-delete">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- 6. Certifications -->
    <section id="certifications" class="admin-section">
      <h2><span>📜 Certifications & Accreditations</span> <span class="tab-badge"><%= certifications.length %> Records</span></h2>
      <form action="/admin/certifications/create" method="POST" style="margin-bottom: 1.5rem;">
        <div class="form-row">
          <input type="text" name="title" placeholder="Certification Title" required />
          <input type="text" name="issuer" placeholder="Issuer (e.g. AWS)" required />
        </div>
        <div class="form-row">
          <input type="text" name="issue_date" placeholder="Year / Date" required />
          <input type="url" name="credential_url" placeholder="Credential Verification Link" />
        </div>
        <button type="submit" class="btn primary" style="align-self: flex-start;">+ Add Certificate</button>
      </form>

      <table class="admin-table">
        <thead><tr><th>Title</th><th>Issuer</th><th>Date</th><th>Action</th></tr></thead>
        <tbody>
          <% certifications.forEach(c => { %>
            <tr>
              <td><strong><%= c.title %></strong></td>
              <td><%= c.issuer %></td>
              <td><%= c.issue_date %></td>
              <td>
                <form action="/admin/certifications/delete/<%= c.id %>" method="POST" onsubmit="return confirm('Delete this certificate?');">
                  <button type="submit" class="btn-delete">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- 7. Feedback Moderation -->
    <section id="feedback" class="admin-section">
      <h2><span>⭐ Feedback & Testimonials</span> <span class="tab-badge"><%= feedback.length %> Records</span></h2>
      <table class="admin-table">
        <thead><tr><th>From</th><th>Message</th><th>Source Link</th><th>Action</th></tr></thead>
        <tbody>
          <% feedback.forEach(f => { %>
            <tr>
              <td><strong><%= f.client_name %></strong><br><span style="color:var(--text-muted);"><%= f.designation %></span></td>
              <td>"<%= f.message %>"</td>
              <td><%= f.source_url ? f.source_url : 'None' %></td>
              <td>
                <form action="/admin/feedback/delete/<%= f.id %>" method="POST" onsubmit="return confirm('Delete this testimonial?');">
                  <button type="submit" class="btn-delete">Remove</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- 8. Connect Messages -->
    <section id="messages" class="admin-section">
      <h2><span>✉️ Received Messages</span> <span class="tab-badge"><%= messages.length %> Inquiries</span></h2>
      <table class="admin-table">
        <thead><tr><th>Sender</th><th>Subject & Message</th><th>Date</th><th>Action</th></tr></thead>
        <tbody>
          <% messages.forEach(m => { %>
            <tr>
              <td><strong><%= m.sender_name %></strong><br><a href="mailto:<%= m.sender_email %>" style="color:var(--accent);"><%= m.sender_email %></a></td>
              <td><strong><%= m.subject %></strong><br><span style="color:var(--text-dim);"><%= m.message %></span></td>
              <td><%= new Date(m.created_at).toLocaleDateString() %></td>
              <td>
                <form action="/admin/messages/delete/<%= m.id %>" method="POST" onsubmit="return confirm('Delete this message?');">
                  <button type="submit" class="btn-delete">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

  </main>

  <!-- Active ScrollSpy & Tab Highlight Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.nav-tab-item');
      const sections = document.querySelectorAll('.admin-section');

      // IntersectionObserver for live tab highlighting while scrolling
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const activeId = entry.target.getAttribute('id');
            tabs.forEach(tab => {
              const href = tab.getAttribute('href').substring(1);
              if (href === activeId) {
                tab.classList.add('active');
                tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
              } else {
                tab.classList.remove('active');
              }
            });
          }
        });
      }, { rootMargin: '-140px 0px -60% 0px' });

      sections.forEach(section => observer.observe(section));
    });
  </script>

</body>
</html>