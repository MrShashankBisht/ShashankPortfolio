<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= profile.name %> | <%= profile.headline %>
  </title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="/styles.css" />
</head>

<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-brand">
      <a href="#about" id="nav-name">
        <%= profile.name %>
      </a>
    </div>
    <ul class="nav-links">
      <li><a href="#about">About</a></li>
      <li><a href="#skills">Tech Stack</a></li>
      <li><a href="#experience">Journey</a></li>
      <li><a href="#education">Education</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#repos">Git Repos</a></li>
      <li><a href="#certifications">Certifications</a></li>
      <li><a href="#feedback">Feedback</a></li>
      <li><a href="#connect" class="nav-btn-connect">Connect</a></li>
    </ul>
  </nav>

  <!-- Hero Section -->
  <header id="about" class="section hero-section">
    <div class="hero-container">
      <div class="avatar-wrapper">
        <div class="avatar-ring">
          <img id="profile-img" src="https://github.com/<%= profile.github_username %>.png" alt="<%= profile.name %>"
            onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.name) %>&background=6366f1&color=fff&size=256';" />
        </div>
        <div class="status-indicator" title="Available for Opportunities"></div>
      </div>

      <div class="hero-text">
        <span class="badge">Open for Engineering & Architecture Roles</span>
        <h1 id="profile-name">
          <%= profile.name %>
        </h1>
        <p class="headline" id="profile-headline">
          <%= profile.headline %>
        </p>
        <p class="bio" id="profile-bio">
          <%= profile.bio %>
        </p>

        <div class="hero-actions">
          <a href="#connect" class="btn primary">Get in Touch</a>
          <a href="#experience" class="btn secondary">View Work Journey</a>
          <% if (profile.linkedin_url) { %>
            <a href="<%= profile.linkedin_url %>" target="_blank" rel="noopener noreferrer"
              class="btn icon-btn">LinkedIn ↗</a>
            <% } %>
              <% if (profile.github_username) { %>
                <a href="https://github.com/<%= profile.github_username %>" target="_blank" rel="noopener noreferrer"
                  class="btn icon-btn">GitHub ↗</a>
                <% } %>
        </div>
      </div>
    </div>
  </header>

  <!-- Skills Stack (Dynamic from PostgreSQL) -->
  <section id="skills" class="section">
    <h2 class="section-title">Core Expertise</h2>
    <div class="skills-grid">
      <% if (skills && skills.length> 0) { %>
        <% skills.forEach(skill=> { %>
          <div class="skill-tag">
            <%= skill.name %>
          </div>
          <% }); %>
            <% } else { %>
              <div class="skill-tag">Kotlin / Java</div>
              <div class="skill-tag">Jetpack Compose</div>
              <div class="skill-tag">MVVM & Clean Architecture</div>
              <div class="skill-tag">Coroutines & Flow</div>
              <div class="skill-tag">Room DB & PostgreSQL</div>
              <div class="skill-tag">AI Agents & Ollama</div>
              <div class="skill-tag">AWS (Lambda, S3, DynamoDB)</div>
              <div class="skill-tag">Docker & Nginx</div>
              <% } %>
    </div>
  </section>

  <!-- Career Experience / Job Journey (Dynamic from PostgreSQL) -->
  <section id="experience" class="section">
    <h2 class="section-title">Professional Journey</h2>
    <p class="section-subtitle">6+ years of engineering roles and corporate leadership</p>

    <div class="timeline" id="experience-container">
      <% if (experiences && experiences.length> 0) { %>
        <% experiences.forEach(exp=> { %>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-header">
              <h3 class="timeline-role">
                <%= exp.role %>
              </h3>
              <span class="timeline-period">
                <%= exp.period %>
              </span>
            </div>
            <p class="timeline-company">
              <%= exp.company %> • <%= exp.location %>
            </p>
            <p class="timeline-desc">
              <%= exp.description %>
            </p>
            <% if (exp.skills_used) { %>
              <p class="timeline-tech">Stack: <span>
                  <%= exp.skills_used %>
                </span></p>
              <% } %>
          </div>
          <% }); %>
            <% } else { %>
              <p style="color: var(--text-muted);">No experiences loaded.</p>
              <% } %>
    </div>
  </section>

  <!-- Education & Academic Background -->
  <section id="education" class="section">
    <h2 class="section-title">Education & Academics</h2>
    <p class="section-subtitle">Degrees and academic qualifications</p>

    <div class="grid edu-grid" id="education-container">
      <% if (education && education.length> 0) { %>
        <% education.forEach(edu=> { %>
          <div class="card edu-card">
            <div>
              <span class="edu-period">
                <%= edu.period %>
              </span>
              <h3 class="edu-degree">
                <%= edu.degree %>
              </h3>
              <p class="edu-institution">
                <%= edu.institution %>
              </p>
            </div>
            <% if (edu.description) { %>
              <p class="edu-desc">
                <%= edu.description %>
              </p>
              <% } %>
          </div>
          <% }); %>
            <% } else { %>
              <p style="color: var(--text-muted);">No education records found.</p>
              <% } %>
    </div>
  </section>

  <!-- Corporate, Apps & AI Projects (Dynamic from PostgreSQL) -->
  <section id="projects" class="section">
    <div class="section-header-flex">
      <div>
        <h2 class="section-title">Featured Apps & AI Projects</h2>
        <p class="section-subtitle">Corporate solutions, native mobile architectures, and AI agent systems</p>
      </div>
    </div>

    <div class="grid" id="projects-container">
      <% if (projects && projects.length> 0) { %>
        <% projects.forEach(proj=> { %>
          <div class="card project-card">
            <div>
              <span class="project-cat">
                <%= proj.category %>
              </span>
              <h3>
                <%= proj.title %>
              </h3>
              <p class="project-desc">
                <%= proj.description %>
              </p>
            </div>
            <div>
              <div class="project-tech">
                <%= proj.technologies %>
              </div>
              <div style="display: flex; gap: 1rem; font-size: 0.85rem; margin-top: 0.5rem;">
                <% if (proj.github_url) { %>
                  <a href="<%= proj.github_url %>" target="_blank" rel="noopener noreferrer"
                    style="color: var(--accent); text-decoration: none; font-weight: 600;">GitHub Code ↗</a>
                  <% } %>
                    <% if (proj.live_url) { %>
                      <a href="<%= proj.live_url %>" target="_blank" rel="noopener noreferrer"
                        style="color: var(--primary); text-decoration: none; font-weight: 600;">Live Demo ↗</a>
                      <% } %>
              </div>
            </div>
          </div>
          <% }); %>
            <% } else { %>
              <p style="color: var(--text-muted);">No projects loaded.</p>
              <% } %>
    </div>
  </section>

  <!-- GitHub Repositories (Server Rendered) -->
  <section id="repos" class="section">
    <div class="section-header-flex">
      <div>
        <h2 class="section-title">Open Source & Git Repositories</h2>
        <p class="section-subtitle">Live repositories retrieved dynamically from GitHub</p>
      </div>
      <a href="https://github.com/<%= profile.github_username %>?tab=repositories" target="_blank"
        rel="noopener noreferrer" class="view-all-link">View All on GitHub ↗</a>
    </div>

    <div class="grid" id="repos-container">
      <% if (repos && repos.length> 0) { %>
        <% repos.forEach(repo=> { %>
          <div class="card repo-card">
            <div>
              <h3><a href="<%= repo.html_url %>" target="_blank" rel="noopener noreferrer">
                  <%= repo.name %>
                </a></h3>
              <p class="repo-desc">
                <%= repo.description || 'Repository codebase and implementation architecture.' %>
              </p>
            </div>
            <div class="repo-meta">
              <span>★ <%= repo.stargazers_count %></span>
              <span>⚡ <%= repo.language || 'Kotlin/Java' %></span>
              <span>🔀 <%= repo.forks_count %></span>
            </div>
          </div>
          <% }); %>
            <% } else { %>
              <p style="color: var(--text-muted);">No repositories found or GitHub rate limit reached.</p>
              <% } %>
    </div>
  </section>

  <!-- Certifications (Dynamic from PostgreSQL) -->
  <section id="certifications" class="section">
    <h2 class="section-title">Licenses & Certifications</h2>
    <p class="section-subtitle">Verified credentials stored in PostgreSQL</p>

    <div class="grid certs-grid" id="certs-container">
      <% if (certifications && certifications.length> 0) { %>
        <% certifications.forEach(cert=> { %>
          <div class="card">
            <h3>
              <%= cert.title %>
            </h3>
            <p style="color: var(--accent); font-weight: 500; margin-top: 0.3rem;">
              <%= cert.issuer %>
            </p>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.2rem;">Issued: <%= cert.issue_date
                || 'N/A' %>
            </p>
            <% if (cert.credential_url) { %>
              <a href="<%= cert.credential_url %>" target="_blank" rel="noopener noreferrer"
                style="color: var(--primary); font-size: 0.85rem; font-weight: 600; display: inline-block; margin-top: 0.8rem; text-decoration: none;">
                Verify Credential ↗
              </a>
              <% } %>
          </div>
          <% }); %>
            <% } else { %>
              <p style="color: var(--text-muted);">No certifications listed.</p>
              <% } %>
    </div>
  </section>

  <!-- Testimonials / Feedback (Dynamic from PostgreSQL) -->
  <section id="feedback" class="section">
    <h2 class="section-title">Client & Peer Feedback</h2>
    <p class="section-subtitle">Testimonials with verifiable source links</p>

    <div class="grid feedback-grid" id="feedback-container">
      <% if (feedback && feedback.length> 0) { %>
        <% feedback.forEach(item=> { %>
          <div class="card feedback-card">
            <p class="feedback-text">"<%= item.message %>"</p>
            <div class="feedback-footer">
              <div class="author-info">
                <strong>
                  <%= item.client_name %>
                </strong>
                <p class="designation">
                  <%= item.designation %>
                </p>
                <% if (item.source_url) { %>
                  <a href="<%= item.source_url %>" target="_blank" rel="noopener noreferrer" class="source-link">
                    View Source ↗
                  </a>
                  <% } %>
              </div>
              <span class="rating-stars">
                <%= '★' .repeat(item.rating || 5) %>
              </span>
            </div>
          </div>
          <% }); %>
            <% } else { %>
              <p style="color: var(--text-muted);">No testimonials yet. Be the first to leave one below!</p>
              <% } %>
    </div>
    <!-- Native App-Style Feedback Component -->
    <div class="card native-feedback-box">
      <div class="feedback-header">
        <h3>Rate your experience</h3>
        <p class="form-desc">Tap a star to rate, then leave your recommendation.</p>
      </div>

      <form id="feedback-form" class="native-form">

        <!-- Large Native Star Touch Targets -->
        <div class="native-rating-container">
          <div class="native-stars">
            <input type="radio" id="star5" name="rating" value="5" checked />
            <label for="star5" class="star" aria-label="5 stars">★</label>

            <input type="radio" id="star4" name="rating" value="4" />
            <label for="star4" class="star" aria-label="4 stars">★</label>

            <input type="radio" id="star3" name="rating" value="3" />
            <label for="star3" class="star" aria-label="3 stars">★</label>

            <input type="radio" id="star2" name="rating" value="2" />
            <label for="star2" class="star" aria-label="2 stars">★</label>

            <input type="radio" id="star1" name="rating" value="1" />
            <label for="star1" class="star" aria-label="1 star">★</label>
          </div>
          <span class="rating-text" id="rating-helper">Excellent</span>
        </div>

        <!-- Inputs styling mimicking Material/iOS fields -->
        <div class="input-group">
          <input type="text" id="fb-name" placeholder="Name" required />
          <input type="text" id="fb-designation" placeholder="Role & Company" required />
        </div>

        <div class="input-group">
          <input type="url" id="fb-source" placeholder="Verification Link (e.g. LinkedIn)" />
        </div>

        <div class="input-group textarea-group">
          <textarea id="fb-message" rows="4"
            placeholder="Describe your experience working together (optional but appreciated)..." required></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn native-submit">Post Review</button>
        </div>
      </form>
    </div>
  </section>

  <!-- Connect Section -->
  <section id="connect" class="section">
    <div class="card connect-card">
      <h2 class="section-title">Let's Connect</h2>
      <p class="section-subtitle">Send a direct message. Submissions are saved to PostgreSQL.</p>

      <form id="connect-form">
        <div class="form-row">
          <input type="text" id="conn-name" placeholder="Your Name" required />
          <input type="email" id="conn-email" placeholder="Your Email Address" required />
        </div>
        <input type="text" id="conn-subject" placeholder="Subject / Project Inquiry" required />
        <textarea id="conn-message" rows="4" placeholder="How can I help you or what are you building?"
          required></textarea>
        <button type="submit" class="btn primary">Send Message</button>
      </form>
      <div id="conn-status" class="status-msg"></div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <p>© 2026 <%= profile.name %>. Powered by Node.js, Express & PostgreSQL.</p>
  </footer>

  <script src="/app.js"></script>
</body>

</html>